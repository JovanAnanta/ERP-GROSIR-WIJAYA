# Salin menjadi .env pada server. Jangan commit file .env yang sudah diisi.
DB_PASSWORD=ganti_dengan_password_database_yang_kuat
# Encode karakter khusus password sesuai format URL bila diperlukan.
DATABASE_URL=postgresql://erp_admin:ganti_dengan_password_database_yang_kuat@postgres:5432/erp_grosir_wijaya?schema=public
APP_ORIGIN=https://erp.example.com
APP_PORT=8080
