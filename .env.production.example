# Salin menjadi .env pada server. Jangan commit file .env yang sudah diisi.
DB_PASSWORD=ganti_dengan_password_database_yang_kuat
# Encode karakter khusus password sesuai format URL bila diperlukan.
DATABASE_URL=postgresql://erp_admin:ganti_dengan_password_database_yang_kuat@postgres:5432/erp_grosir_wijaya?schema=public
APP_ORIGIN=https://erp.example.com
APP_PORT=8080

# Image release yang akan dijalankan. Gunakan tag rilis tetap, misalnya v1.0.0.
APP_VERSION=v1.0.0
BACKEND_IMAGE=ghcr.io/jovanananta/erp-grosir-wijaya-backend
MIGRATION_IMAGE=ghcr.io/jovanananta/erp-grosir-wijaya-migration
FRONTEND_IMAGE=ghcr.io/jovanananta/erp-grosir-wijaya-frontend
BACKUP_IMAGE=ghcr.io/jovanananta/erp-grosir-wijaya-backup

# Cloudflare R2/restic. Kredensial disimpan di folder secrets, bukan di file ini.
RESTIC_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/erp-grosir-wijaya-backup
TZ=Asia/Jakarta
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=12
