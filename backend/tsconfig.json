{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2023",

    "lib": ["ES2023"],
    "types": ["node", "jest"],

    "rootDir": "./",
    "outDir": "./dist",

    "declaration": true,
    "sourceMap": true,
    "removeComments": true,

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "isolatedModules": true,

    "strict": true,

    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true,

    "incremental": true
  },
  "include": [
    "src",
    "test",
    "generated",
    "prisma",
    "prisma.config.ts"
  ]
}
