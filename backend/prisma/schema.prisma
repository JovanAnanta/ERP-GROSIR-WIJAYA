model SystemConfiguration {
  id             Int      @id @default(1)
  companyName    String   @map("company_name") @db.VarChar(150)
  address        String   @db.Text
  phone          String   @db.VarChar(50)
  logoBase64     String?  @map("logo_base64") @db.Text
  receiptHeader1 String?  @map("receipt_header_1") @db.VarChar(255)
  receiptHeader2 String?  @map("receipt_header_2") @db.VarChar(255)
  receiptHeader3 String?  @map("receipt_header_3") @db.VarChar(255)
  receiptFooter1 String?  @map("receipt_footer_1") @db.Text
  receiptFooter2 String?  @map("receipt_footer_2") @db.Text
  receiptFooter3 String?  @map("receipt_footer_3") @db.Text
  updatedAt      DateTime @updatedAt @map("updated_at")
  updatedBy      BigInt?  @map("updated_by")

  @@map("system_configuration")
}
