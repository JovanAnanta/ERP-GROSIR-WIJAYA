enum FifoLayerOriginType {
  PURCHASE_INVOICE
  PURCHASE_RETURN
  SALES_RETURN
  OPENING_BALANCE
  INVENTORY_TRANSFORMATION
  INVENTORY_ADJUSTMENT
  INVENTORY_LOAN_RETURN
}

enum TransformationMovementRole {
  SOURCE
  RESULT
}

enum TransactionDirection {
  IN
  OUT
}

model FifoLayer {
  fifoLayerId               BigInt              @id @default(autoincrement()) @map("fifo_layer_id")
  fifoLayerNumber           String              @unique @map("fifo_layer_number") @db.VarChar(30)
  productUnitId             BigInt              @map("product_unit_id")
  purchaseInvoiceDetailId   BigInt?             @map("purchase_invoice_detail_id")
  originType                FifoLayerOriginType @map("origin_type")
  originInventoryMovementId BigInt              @map("origin_inventory_movement_id")
  originId                  BigInt              @map("origin_id")
  originalQty               Decimal             @map("original_qty") @db.Decimal(18, 3)
  remainingQty              Decimal             @map("remaining_qty") @db.Decimal(18, 3)
  unitCost                  Decimal             @map("unit_cost") @db.Decimal(18, 2)
  originalCost              Decimal             @map("original_cost") @db.Decimal(18, 2)
  remainingCost             Decimal             @map("remaining_cost") @db.Decimal(18, 2)
  createdAt                 DateTime            @default(now()) @map("created_at")
  createdBy                 BigInt              @map("created_by")

  productUnit             ProductUnit            @relation(fields: [productUnitId], references: [productUnitId])
  purchaseInvoiceDetail   PurchaseInvoiceDetail? @relation(fields: [purchaseInvoiceDetailId], references: [purchaseInvoiceDetailId], onDelete: Restrict)
  originInventoryMovement InventoryMovement      @relation("MovementGeneratedLayers", fields: [originInventoryMovementId], references: [inventoryMovementId])
  createdByUser           User                   @relation("FifoLayerCreatedBy", fields: [createdBy], references: [userId])
  transactions            FifoLayerTransaction[]
  purchaseReturnDetails   PurchaseReturnDetail[]

  @@index([productUnitId])
  @@index([purchaseInvoiceDetailId])
  @@index([originInventoryMovementId])
  @@index([productUnitId, remainingQty, createdAt, fifoLayerId], map: "fifo_layer_product_remaining_created_idx")
  @@index([originType, originId], map: "fifo_layer_origin_idx")
  @@index([createdBy])
  @@map("fifo_layer")
}

model FifoLayerTransaction {
  fifoLayerTransactionId BigInt               @id @default(autoincrement()) @map("fifo_layer_transaction_id")
  fifoLayerId            BigInt               @map("fifo_layer_id")
  inventoryMovementId    BigInt               @map("inventory_movement_id")
  quantity               Decimal              @db.Decimal(18, 3)
  direction              TransactionDirection @map("direction")
  unitCost               Decimal              @map("unit_cost") @db.Decimal(18, 2)
  totalCost              Decimal              @map("total_cost") @db.Decimal(18, 2)
  quantityBefore         Decimal              @map("quantity_before") @db.Decimal(18, 3)
  quantityAfter          Decimal              @map("quantity_after") @db.Decimal(18, 3)
  createdAt              DateTime             @default(now()) @map("created_at")
  createdBy              BigInt               @map("created_by")

  fifoLayer         FifoLayer         @relation(fields: [fifoLayerId], references: [fifoLayerId])
  inventoryMovement InventoryMovement @relation("MovementConsumedLayers", fields: [inventoryMovementId], references: [inventoryMovementId])
  createdByUser     User              @relation("FifoLayerTransactionCreatedBy", fields: [createdBy], references: [userId])

  @@index([fifoLayerId])
  @@index([inventoryMovementId])
  @@index([fifoLayerId, createdAt, fifoLayerTransactionId], map: "fifo_layer_transaction_layer_created_idx")
  @@index([createdBy])
  @@map("fifo_layer_transaction")
}

model InventoryTransformation {
