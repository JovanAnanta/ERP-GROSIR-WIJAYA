// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/**
 * USER & ROLES
 */

model User {
  userId       BigInt    @id @default(autoincrement()) @map("user_id")
  username     String    @unique @db.VarChar(50)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  fullName     String    @map("full_name") @db.VarChar(150)
  roleId       BigInt    @map("role_id")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  lastLoginIp  String?   @map("last_login_ip") @db.VarChar(45)
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    BigInt?   @map("created_by")
  updatedAt    DateTime? @updatedAt @map("updated_at")
  updatedBy    BigInt?   @map("updated_by")

  role Role @relation("UserRole", fields: [roleId], references: [roleId])

  createdByUser User?  @relation("UserCreatedBy", fields: [createdBy], references: [userId])
  createdUsers  User[] @relation("UserCreatedBy")

  updatedByUser User?  @relation("UserUpdatedBy", fields: [updatedBy], references: [userId])
  updatedUsers  User[] @relation("UserUpdatedBy")

  sessions UserSession[]

  createdRoles           Role[]           @relation("RoleCreatedBy")
  createdRolePermissions RolePermission[] @relation("RolePermissionCreatedBy")

  /**
   * MASTER DATA
   */
  createdCategories       Category[]        @relation("CategoryCreatedBy")
  updatedCategories       Category[]        @relation("CategoryUpdatedBy")
  createdBrands           Brand[]           @relation("BrandCreatedBy")
  updatedBrands           Brand[]           @relation("BrandUpdatedBy")
  createdUnits            Unit[]            @relation("UnitCreatedBy")
  updatedUnits            Unit[]            @relation("UnitUpdatedBy")
  createdProducts         Product[]         @relation("ProductCreatedBy")
  updatedProducts         Product[]         @relation("ProductUpdatedBy")
  createdProductUnits     ProductUnit[]     @relation("ProductUnitCreatedBy")
  updatedProductUnits     ProductUnit[]     @relation("ProductUnitUpdatedBy")
  createdSuppliers        Supplier[]        @relation("SupplierCreatedBy")
  updatedSuppliers        Supplier[]        @relation("SupplierUpdatedBy")
  createdProductSuppliers ProductSupplier[] @relation("ProductSupplierCreatedBy")
  updatedProductSuppliers ProductSupplier[] @relation("ProductSupplierUpdatedBy")
  createdCustomers        Customer[]        @relation("CustomerCreatedBy")
  updatedCustomers        Customer[]        @relation("CustomerUpdatedBy")

  /**
   * PURCHASE
   */
  createdPurchaseOrders          PurchaseOrder[]          @relation("PurchaseOrderCreatedBy")
  updatedPurchaseOrders          PurchaseOrder[]          @relation("PurchaseOrderUpdatedBy")
  createdPurchaseInvoices        PurchaseInvoice[]        @relation("PurchaseInvoiceCreatedBy")
  updatedPurchaseInvoices        PurchaseInvoice[]        @relation("PurchaseInvoiceUpdatedBy")
  createdPurchaseReturns         PurchaseReturn[]         @relation("PurchaseReturnCreatedBy")
  updatedPurchaseReturns         PurchaseReturn[]         @relation("PurchaseReturnUpdatedBy")
  createdPurchaseInvoicePayments PurchaseInvoicePayment[] @relation("PurchaseInvoicePaymentCreatedBy")

  /**
   * FINANCIAL
   */
  createdCustomerAccountTransactions  CustomerAccountTransaction[]  @relation("CustomerAccountTransactionCreatedBy")
  createdSupplierAccountTransactions  SupplierAccountTransaction[]  @relation("SupplierAccountTransactionCreatedBy")
  createdFinancialAccounts            FinancialAccount[]            @relation("FinancialAccountCreatedBy")
  updatedFinancialAccounts            FinancialAccount[]            @relation("FinancialAccountUpdatedBy")
  createdFinancialAccountTransactions FinancialAccountTransaction[] @relation("FinancialAccountTransactionCreatedBy")

  /**
   * INVENTORY
   */
  createdFifoLayers                     FifoLayer[]                     @relation("FifoLayerCreatedBy")
  createdFifoLayerTransactions          FifoLayerTransaction[]          @relation("FifoLayerTransactionCreatedBy")
  createdInventoryTransformations       InventoryTransformation[]       @relation("InventoryTransformationCreatedBy")
  createdInventoryTransformationDetails InventoryTransformationDetail[] @relation("InventoryTransformationDetailCreatedBy")
  createdInventoryMovements             InventoryMovement[]             @relation("InventoryMovementCreatedBy")
  createdInventoryAdjustments           InventoryAdjustment[]           @relation("InventoryAdjustmentCreatedBy")
  approvedInventoryAdjustments          InventoryAdjustment[]           @relation("InventoryAdjustmentApprovedBy")
  updatedInventoryAdjustments           InventoryAdjustment[]           @relation("InventoryAdjustmentUpdatedBy")
  cancelledInventoryAdjustments         InventoryAdjustment[]           @relation("InventoryAdjustmentCancelledBy")
  createdInventoryAdjustmentDetails     InventoryAdjustmentDetail[]     @relation("InventoryAdjustmentDetailCreatedBy")
  createdStockOpnames                   StockOpname[]                   @relation("StockOpnameCreatedBy")
  approvedStockOpnames                  StockOpname[]                   @relation("StockOpnameApprovedBy")
  updatedStockOpnames                   StockOpname[]                   @relation("StockOpnameUpdatedBy")
  cancelledStockOpnames                 StockOpname[]                   @relation("StockOpnameCancelledBy")
  createdStockOpnameDetails             StockOpnameDetail[]             @relation("StockOpnameDetailCreatedBy")

  /**
   * SALES
   */
  createdSalesOrders          SalesOrder[]          @relation("SalesOrderCreatedBy")
  updatedSalesOrders          SalesOrder[]          @relation("SalesOrderUpdatedBy")
  createdSalesInvoices        SalesInvoice[]        @relation("SalesInvoiceCreatedBy")
  approvedSalesInvoices       SalesInvoice[]        @relation("SalesInvoiceApprovedBy")
  createdSalesInvoiceDetails  SalesInvoiceDetail[]  @relation("SalesInvoiceDetailCreatedBy")
  createdSalesInvoicePayments SalesInvoicePayment[] @relation("SalesInvoicePaymentCreatedBy")
  updatedSalesInvoices        SalesInvoice[]        @relation("SalesInvoiceUpdatedBy")
  cancelledSalesInvoices      SalesInvoice[]        @relation("SalesInvoiceCancelledBy")
  resolvedPaymentHoldings     SalesPaymentHolding[] @relation("SalesPaymentHoldingResolvedBy")
  createdSalesReturns         SalesReturn[]         @relation("SalesReturnCreatedBy")
  approvedSalesReturns        SalesReturn[]         @relation("SalesReturnApprovedBy")
  createdSalesReturnDetails   SalesReturnDetail[]   @relation("SalesReturnDetailCreatedBy")

  /**
   * PRICING
   */
  createdGuestPrices    GuestSuggestedPrice[]    @relation("GuestPriceCreatedBy")
  updatedGuestPrices    GuestSuggestedPrice[]    @relation("GuestPriceUpdatedBy")
  createdCustomerPrices CustomerSuggestedPrice[] @relation("CustomerPriceCreatedBy")
  updatedCustomerPrices CustomerSuggestedPrice[] @relation("CustomerPriceUpdatedBy")
  createdSupplierCosts  SupplierSuggestedCost[]  @relation("SupplierCostCreatedBy")
  updatedSupplierCosts  SupplierSuggestedCost[]  @relation("SupplierCostUpdatedBy")
  createdProductAliases ProductAlias[]           @relation("ProductAliasCreatedBy")
  createdUnitAliases    UnitAlias[]              @relation("UnitAliasCreatedBy")

  /**
   * LOGGING
   */
  auditLogs    AuditLog[]
  activityLogs ActivityLog[]
  securityLogs SecurityLog[]

  @@index([roleId])
  @@index([createdBy])
  @@index([updatedBy])
  @@map("user")
}

model Role {
  roleId    BigInt   @id @default(autoincrement()) @map("role_id")
  roleCode  String   @unique @map("role_code") @db.VarChar(30)
  roleName  String   @map("role_name") @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  createdBy BigInt?  @map("created_by")

  users       User[]           @relation("UserRole")
  permissions RolePermission[]

  createdByUser User? @relation("RoleCreatedBy", fields: [createdBy], references: [userId])

  @@index([createdBy])
  @@map("role")
}

model Permission {
  permissionId   BigInt   @id @default(autoincrement()) @map("permission_id")
  permissionCode String   @unique @map("permission_code") @db.VarChar(100)
  permissionName String   @map("permission_name") @db.VarChar(150)
  module         String   @db.VarChar(50)
  action         String   @db.VarChar(30)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@index([module])
  @@index([action])
  @@map("permission")
}

model RolePermission {
  rolePermissionId BigInt   @id @default(autoincrement()) @map("role_permission_id")
  roleId           BigInt   @map("role_id")
  permissionId     BigInt   @map("permission_id")
  createdAt        DateTime @default(now()) @map("created_at")
  createdBy        BigInt?  @map("created_by")

  role       Role       @relation(fields: [roleId], references: [roleId])
  permission Permission @relation(fields: [permissionId], references: [permissionId])

  createdByUser User? @relation("RolePermissionCreatedBy", fields: [createdBy], references: [userId])

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@index([createdBy])
  @@map("role_permission")
}

model UserSession {
  sessionId        BigInt    @id @default(autoincrement()) @map("session_id")
  userId           BigInt    @map("user_id")
  sessionTokenHash String    @unique @map("session_token_hash") @db.VarChar(255)
  deviceIdentifier String    @map("device_identifier") @db.VarChar(255)
  ipAddress        String    @map("ip_address") @db.VarChar(45)
  userAgent        String?   @map("user_agent") @db.VarChar(500)
  createdAt        DateTime  @default(now()) @map("created_at")
  lastActivityAt   DateTime  @map("last_activity_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  revokeReason     String?   @map("revoke_reason") @db.VarChar(100)

  user User @relation(fields: [userId], references: [userId])

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("user_session")
}

/**
 * MASTER DATA
 */

model Category {
  categoryId   BigInt    @id @default(autoincrement()) @map("category_id")
  categoryName String    @unique @map("category_name") @db.VarChar(100)
  isActive     Boolean   @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    BigInt    @map("created_by")
  updatedAt    DateTime? @updatedAt @map("updated_at")
  updatedBy    BigInt?   @map("updated_by")

  createdByUser User  @relation("CategoryCreatedBy", fields: [createdBy], references: [userId])
  updatedByUser User? @relation("CategoryUpdatedBy", fields: [updatedBy], references: [userId])

  products Product[]

  @@index([createdBy])
  @@index([updatedBy])
  @@map("category")
}

model Brand {
  brandId   BigInt    @id @default(autoincrement()) @map("brand_id")
  brandName String    @unique @map("brand_name") @db.VarChar(100)
  isActive  Boolean   @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy BigInt    @map("created_by")
  updatedAt DateTime? @updatedAt @map("updated_at")
  updatedBy BigInt?   @map("updated_by")

  createdByUser User  @relation("BrandCreatedBy", fields: [createdBy], references: [userId])
  updatedByUser User? @relation("BrandUpdatedBy", fields: [updatedBy], references: [userId])

  products Product[]

  @@index([createdBy])
  @@index([updatedBy])
  @@map("brand")
}

model Unit {
  unitId    BigInt    @id @default(autoincrement()) @map("unit_id")
  unitName  String    @unique @map("unit_name") @db.VarChar(50)
  isActive  Boolean   @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy BigInt    @map("created_by")
  updatedAt DateTime? @updatedAt @map("updated_at")
  updatedBy BigInt?   @map("updated_by")

  createdByUser User  @relation("UnitCreatedBy", fields: [createdBy], references: [userId])
  updatedByUser User? @relation("UnitUpdatedBy", fields: [updatedBy], references: [userId])

  productUnits ProductUnit[]

  aliases UnitAlias[]

  @@index([createdBy])
  @@index([updatedBy])
  @@map("unit")
}

model Product {
  productId           BigInt    @id @default(autoincrement()) @map("product_id")
  productName         String    @map("product_name") @db.VarChar(255)
  categoryId          BigInt    @map("category_id")
  brandId             BigInt?   @map("brand_id")
  isActive            Boolean   @map("is_active")
  minimumInventoryQty Decimal   @map("minimum_inventory_qty") @db.Decimal(18, 3)
  createdAt           DateTime  @default(now()) @map("created_at")
  createdBy           BigInt    @map("created_by")
  updatedAt           DateTime? @updatedAt @map("updated_at")
  updatedBy           BigInt?   @map("updated_by")

  category      Category @relation(fields: [categoryId], references: [categoryId])
  brand         Brand?   @relation(fields: [brandId], references: [brandId])
  createdByUser User     @relation("ProductCreatedBy", fields: [createdBy], references: [userId])
  updatedByUser User?    @relation("ProductUpdatedBy", fields: [updatedBy], references: [userId])

  productUnits     ProductUnit[]
  productSuppliers ProductSupplier[]
  inventoryStocks  InventoryStock[]

  aliases ProductAlias[]

  @@index([categoryId])
  @@index([brandId])
  @@index([createdBy])
  @@index([updatedBy])
  @@map("product")
}

model ProductUnit {
  productUnitId       BigInt    @id @default(autoincrement()) @map("product_unit_id")
  productId           BigInt    @map("product_id")
  unitId              BigInt    @map("unit_id")
  parentProductUnitId BigInt?   @map("parent_product_unit_id")
  conversionFactor    Decimal   @map("conversion_factor") @db.Decimal(18, 6)
  displayOrder        Int       @map("display_order")
  isParent            Boolean   @map("is_parent")
  isActive            Boolean   @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at")
  createdBy           BigInt    @map("created_by")
  updatedAt           DateTime? @updatedAt @map("updated_at")
  updatedBy           BigInt?   @map("updated_by")

  product       Product       @relation(fields: [productId], references: [productId])
  unit          Unit          @relation(fields: [unitId], references: [unitId])
  createdByUser User          @relation("ProductUnitCreatedBy", fields: [createdBy], references: [userId])
  updatedByUser User?         @relation("ProductUnitUpdatedBy", fields: [updatedBy], references: [userId])
  parentUnit    ProductUnit?  @relation("ProductUnitHierarchy", fields: [parentProductUnitId], references: [productUnitId], onDelete: Restrict)
  childUnits    ProductUnit[] @relation("ProductUnitHierarchy")

  /**
   * PURCHASE
   */
  purchaseOrderDetails   PurchaseOrderDetail[]
  purchaseInvoiceDetails PurchaseInvoiceDetail[]
  purchaseReturnDetails  PurchaseReturnDetail[]

  /**
   * INVENTORY
   */
  fifoLayers                 FifoLayer[]
  inventoryMovements         InventoryMovement[]
  transformationSources      InventoryTransformationDetail[] @relation("TransformationSourceUnit")
  transformationResults      InventoryTransformationDetail[] @relation("TransformationResultUnit")
  inventoryAdjustmentDetails InventoryAdjustmentDetail[]
  stockOpnameDetails         StockOpnameDetail[]
  inventoryStocks            InventoryStock[]

  /**
   * SALES
   */
  salesOrderDetails   SalesOrderDetail[]
  salesInvoiceDetails SalesInvoiceDetail[]
  salesReturnDetails  SalesReturnDetail[]

  guestPrices    GuestSuggestedPrice[]
  customerPrices CustomerSuggestedPrice[]
  supplierCosts  SupplierSuggestedCost[]

  @@index([productId])
  @@index([unitId])
  @@index([parentProductUnitId])
  @@index([createdBy])
  @@index([updatedBy])
  @@map("product_unit")
}

model Supplier {
  supplierId   BigInt    @id @default(autoincrement()) @map("supplier_id")
  supplierName String    @map("supplier_name") @db.VarChar(255)
  phone        String?   @db.VarChar(30)
  email        String?   @db.VarChar(150)
  address      String?   @db.Text
  picName      String?   @map("pic_name") @db.VarChar(150)
  isActive     Boolean   @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    BigInt    @map("created_by")
  updatedAt    DateTime? @updatedAt @map("updated_at")
  updatedBy    BigInt?   @map("updated_by")

  createdByUser User  @relation("SupplierCreatedBy", fields: [createdBy], references: [userId])
  updatedByUser User? @relation("SupplierUpdatedBy", fields: [updatedBy], references: [userId])

  productSuppliers    ProductSupplier[]
  purchaseOrders      PurchaseOrder[]
  purchaseInvoices    PurchaseInvoice[]
  purchaseReturns     PurchaseReturn[]
  stockOpnames        StockOpname[]
  financialSummary    SupplierFinancialSummary?
  accountTransactions SupplierAccountTransaction[]

  suggestedCosts SupplierSuggestedCost[]

  @@index([createdBy])
  @@index([updatedBy])
  @@map("supplier")
}

model ProductSupplier {
  productSupplierId BigInt    @id @default(autoincrement()) @map("product_supplier_id")
  productId         BigInt    @map("product_id")
  supplierId        BigInt    @map("supplier_id")
  isActive          Boolean   @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  createdBy         BigInt    @map("created_by")
  updatedAt         DateTime? @updatedAt @map("updated_at")
  updatedBy         BigInt?   @map("updated_by")

  product       Product  @relation(fields: [productId], references: [productId])
  supplier      Supplier @relation(fields: [supplierId], references: [supplierId])
  createdByUser User     @relation("ProductSupplierCreatedBy", fields: [createdBy], references: [userId])
  updatedByUser User?    @relation("ProductSupplierUpdatedBy", fields: [updatedBy], references: [userId])

  @@index([productId])
  @@index([supplierId])
  @@index([createdBy])
  @@index([updatedBy])
  @@map("product_supplier")
}

model Customer {
  customerId   BigInt    @id @default(autoincrement()) @map("customer_id")
  customerName String    @map("customer_name") @db.VarChar(255)
  phone        String?   @db.VarChar(30)
  address      String?   @db.Text
  isActive     Boolean   @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    BigInt    @map("created_by")
  updatedAt    DateTime? @updatedAt @map("updated_at")
  updatedBy    BigInt?   @map("updated_by")

  createdByUser User  @relation("CustomerCreatedBy", fields: [createdBy], references: [userId])
  updatedByUser User? @relation("CustomerUpdatedBy", fields: [updatedBy], references: [userId])

  salesOrders         SalesOrder[]
  salesInvoices       SalesInvoice[]
  salesReturns        SalesReturn[]
  financialSummary    CustomerFinancialSummary?
  accountTransactions CustomerAccountTransaction[]

  suggestedPrices CustomerSuggestedPrice[]

  @@index([createdBy])
  @@index([updatedBy])
  @@map("customer")
}

/**
 * PURCHASE
 */

model PurchaseOrder {
  purchaseOrderId     BigInt              @id @default(autoincrement()) @map("purchase_order_id")
  purchaseOrderNumber String              @unique @map("purchase_order_number") @db.VarChar(30)
  supplierId          BigInt              @map("supplier_id")
  orderDate           DateTime            @map("order_date") @db.Date
  expectedDate        DateTime?           @map("expected_date") @db.Date
  status              PurchaseOrderStatus
  note                String?             @db.VarChar(500)
  createdAt           DateTime            @default(now()) @map("created_at")
  createdBy           BigInt              @map("created_by")
  updatedAt           DateTime?           @updatedAt @map("updated_at")
  updatedBy           BigInt?             @map("updated_by")

  supplier      Supplier @relation(fields: [supplierId], references: [supplierId])
  createdByUser User     @relation("PurchaseOrderCreatedBy", fields: [createdBy], references: [userId])
  updatedByUser User?    @relation("PurchaseOrderUpdatedBy", fields: [updatedBy], references: [userId])

  details          PurchaseOrderDetail[]
  purchaseInvoices PurchaseInvoice[]

  @@index([supplierId])
  @@index([createdBy])
  @@index([updatedBy])
  @@index([status])
  @@map("purchase_order")
}

model PurchaseOrderDetail {
  purchaseOrderDetailId BigInt  @id @default(autoincrement()) @map("purchase_order_detail_id")
  purchaseOrderId       BigInt  @map("purchase_order_id")
  productUnitId         BigInt  @map("product_unit_id")
  quantity              Decimal @db.Decimal(18, 3)
  note                  String? @db.VarChar(255)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [purchaseOrderId])
  productUnit   ProductUnit   @relation(fields: [productUnitId], references: [productUnitId])

  @@index([purchaseOrderId])
  @@index([productUnitId])
  @@map("purchase_order_detail")
}

model PurchaseInvoice {
  purchaseInvoiceId     BigInt                       @id @default(autoincrement()) @map("purchase_invoice_id")
  purchaseInvoiceNumber String                       @unique @map("purchase_invoice_number") @db.VarChar(30)
  purchaseOrderId       BigInt?                      @map("purchase_order_id")
  supplierId            BigInt                       @map("supplier_id")
  invoiceDate           DateTime                     @map("invoice_date") @db.Date
  dueDate               DateTime?                    @map("due_date") @db.Date
  invoiceTotal          Decimal                      @map("invoice_total") @db.Decimal(18, 2)
  discountAmount        Decimal                      @map("discount_amount") @db.Decimal(18, 2)
  statusPayment         PurchaseInvoicePaymentStatus @map("status_payment")
  paidAmount            Decimal                      @map("paid_amount") @db.Decimal(18, 2)
  outstandingAmount     Decimal                      @map("outstanding_amount") @db.Decimal(18, 2)
  status                PurchaseInvoiceStatus
  note                  String?                      @db.VarChar(500)
  createdAt             DateTime                     @default(now()) @map("created_at")
  createdBy             BigInt                       @map("created_by")
  updatedAt             DateTime?                    @updatedAt @map("updated_at")
  updatedBy             BigInt?                      @map("updated_by")

  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [purchaseOrderId])
  supplier      Supplier       @relation(fields: [supplierId], references: [supplierId])
  createdByUser User           @relation("PurchaseInvoiceCreatedBy", fields: [createdBy], references: [userId])
  updatedByUser User?          @relation("PurchaseInvoiceUpdatedBy", fields: [updatedBy], references: [userId])

  details                PurchaseInvoiceDetail[]
  returns                PurchaseReturn[]         @relation("PurchaseReturnSourceInvoice")
  appliedPurchaseReturns PurchaseReturn[]         @relation("PurchaseReturnAppliedInvoice")
  payments               PurchaseInvoicePayment[]

  @@index([purchaseOrderId])
  @@index([supplierId])
  @@index([createdBy])
  @@index([updatedBy])
  @@index([statusPayment])
  @@index([status])
  @@map("purchase_invoice")
}

model PurchaseInvoiceDetail {
  purchaseInvoiceDetailId BigInt  @id @default(autoincrement()) @map("purchase_invoice_detail_id")
  purchaseInvoiceId       BigInt  @map("purchase_invoice_id")
  productUnitId           BigInt  @map("product_unit_id")
  quantity                Decimal @db.Decimal(18, 3)
  unitCost                Decimal @map("unit_cost") @db.Decimal(18, 2)
  subtotal                Decimal @db.Decimal(18, 2)
  note                    String? @db.VarChar(255)

  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [purchaseInvoiceId])
  productUnit     ProductUnit     @relation(fields: [productUnitId], references: [productUnitId])

  purchaseReturnDetails PurchaseReturnDetail[]
  fifoLayers            FifoLayer[]

  @@index([purchaseInvoiceId])
  @@index([productUnitId])
  @@map("purchase_invoice_detail")
}

model PurchaseReturn {
  purchaseReturnId         BigInt                       @id @default(autoincrement()) @map("purchase_return_id")
  purchaseReturnNumber     String                       @unique @map("purchase_return_number") @db.VarChar(30)
  purchaseInvoiceId        BigInt                       @map("purchase_invoice_id")
  supplierId               BigInt                       @map("supplier_id")
  status                   PurchaseReturnStatus         @default(DRAFT)
  resolutionType           PurchaseReturnResolutionType @map("resolution_type")
  returnDate               DateTime                     @map("return_date") @db.Date
  expectedResolutionDate   DateTime?                    @map("expected_resolution_date") @db.Date
  returnTotal              Decimal                      @map("return_total") @db.Decimal(18, 2)
  inventoryCostTotal       Decimal                      @map("inventory_cost_total") @db.Decimal(18, 2)
  financialAccountId       BigInt?                      @map("financial_account_id")
  appliedPurchaseInvoiceId BigInt?                      @map("applied_purchase_invoice_id")
  reason                   String                       @db.VarChar(255)
  note                     String?                      @db.VarChar(500)
  createdAt                DateTime                     @default(now()) @map("created_at")
  createdBy                BigInt                       @map("created_by")
  updatedAt                DateTime?                    @updatedAt @map("updated_at")
  updatedBy                BigInt?                      @map("updated_by")

  purchaseInvoice        PurchaseInvoice   @relation("PurchaseReturnSourceInvoice", fields: [purchaseInvoiceId], references: [purchaseInvoiceId])
  appliedPurchaseInvoice PurchaseInvoice?  @relation("PurchaseReturnAppliedInvoice", fields: [appliedPurchaseInvoiceId], references: [purchaseInvoiceId])
  supplier               Supplier          @relation(fields: [supplierId], references: [supplierId])
  financialAccount       FinancialAccount? @relation(fields: [financialAccountId], references: [financialAccountId])
  createdByUser          User              @relation("PurchaseReturnCreatedBy", fields: [createdBy], references: [userId])
  updatedByUser          User?             @relation("PurchaseReturnUpdatedBy", fields: [updatedBy], references: [userId])

  details PurchaseReturnDetail[]

  @@index([purchaseInvoiceId])
  @@index([supplierId])
  @@index([status])
  @@index([resolutionType])
  @@index([financialAccountId])
  @@index([appliedPurchaseInvoiceId])
  @@index([createdBy])
  @@map("purchase_return")
}

model PurchaseReturnDetail {
  purchaseReturnDetailId  BigInt  @id @default(autoincrement()) @map("purchase_return_detail_id")
  purchaseReturnId        BigInt  @map("purchase_return_id")
  purchaseInvoiceDetailId BigInt  @map("purchase_invoice_detail_id")
  productUnitId           BigInt  @map("product_unit_id")
  fifoLayerId             BigInt  @map("fifo_layer_id")
  quantity                Decimal @db.Decimal(18, 3)
  baseQuantity            Decimal @map("base_quantity") @db.Decimal(18, 3)
  unitCost                Decimal @map("unit_cost") @db.Decimal(18, 2)
  fifoUnitCost            Decimal @map("fifo_unit_cost") @db.Decimal(18, 6)
