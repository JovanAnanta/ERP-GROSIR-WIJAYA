  HELD
  APPLIED
  REFUNDED
  TRANSFERRED
}

enum SalesReturnStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum SalesReturnResolutionType {
  REFUND
  REPLACEMENT
}

enum SalesPaymentMethod {
  CASH
  TRANSFER
}

model SalesOrder {
  salesOrderId     BigInt             @id @default(autoincrement()) @map("sales_order_id")
  salesOrderNumber String             @unique @map("sales_order_number") @db.VarChar(30)
  customerId       BigInt?            @map("customer_id")
  customerName     String?            @map("customer_name") @db.VarChar(255)
  orderDate        DateTime           @map("order_date")
  status           SalesOrderStatus
  salesChannel     String             @map("sales_channel") @db.VarChar(50)
  sourceType       String             @default("MANUAL") @map("source_type") @db.VarChar(50)
  paymentStatus    SalesPaymentStatus @default(UNPAID) @map("payment_status")
  paymentDueDate   DateTime?          @map("payment_due_date") @db.Date
  itemDiscountTotal Decimal           @default(0) @map("item_discount_total") @db.Decimal(18, 2)
  discountAmount   Decimal            @default(0) @map("discount_amount") @db.Decimal(18, 2)
  orderTotal       Decimal            @default(0) @map("order_total") @db.Decimal(18, 2)
  note             String?            @db.VarChar(500)
  createdAt        DateTime           @default(now()) @map("created_at")
  createdBy        BigInt             @map("created_by")
  updatedAt        DateTime?          @updatedAt @map("updated_at")
  updatedBy        BigInt?            @map("updated_by")

  customer      Customer? @relation(fields: [customerId], references: [customerId])
  createdByUser User      @relation("SalesOrderCreatedBy", fields: [createdBy], references: [userId])
  updatedByUser User?     @relation("SalesOrderUpdatedBy", fields: [updatedBy], references: [userId])

  details  SalesOrderDetail[]
  invoices SalesInvoice[]

  @@index([customerId])
  @@index([createdBy])
  @@index([updatedBy])
  @@map("sales_order")
}

model SalesOrderDetail {
  salesOrderDetailId BigInt  @id @default(autoincrement()) @map("sales_order_detail_id")
  salesOrderId       BigInt  @map("sales_order_id")
  productUnitId      BigInt  @map("product_unit_id")
  quantity           Decimal @db.Decimal(18, 3)
  unitPrice          Decimal @default(0) @map("unit_price") @db.Decimal(18, 2)
  discountAmount     Decimal @default(0) @map("discount_amount") @db.Decimal(18, 2)
  bonusQuantity      Decimal @default(0) @map("bonus_quantity") @db.Decimal(18, 3)
  subtotal           Decimal @default(0) @db.Decimal(18, 2)
  note               String? @db.VarChar(255)

  salesOrder  SalesOrder  @relation(fields: [salesOrderId], references: [salesOrderId])
  productUnit ProductUnit @relation(fields: [productUnitId], references: [productUnitId])

  salesInvoiceDetails SalesInvoiceDetail[]

  @@index([salesOrderId])
  @@index([productUnitId])
  @@map("sales_order_detail")
}

model SalesInvoice {
  salesInvoiceId     BigInt             @id @default(autoincrement()) @map("sales_invoice_id")
  salesInvoiceNumber String             @unique @map("sales_invoice_number") @db.VarChar(30)
  salesOrderId       BigInt?            @map("sales_order_id")
  customerId         BigInt?            @map("customer_id")
  partyType          SalesPartyType      @default(CUSTOMER) @map("party_type")
  customerName       String?            @map("customer_name") @db.VarChar(255)
  salesChannel       String              @default("MANUAL") @map("sales_channel") @db.VarChar(50)
  paymentType        SalesPaymentType    @default(CASH) @map("payment_type")
  invoiceDate        DateTime           @map("invoice_date")
  dueDate            DateTime?          @map("due_date") @db.Date
  invoiceTotal       Decimal            @map("invoice_total") @db.Decimal(18, 2)
  discountAmount     Decimal            @map("discount_amount") @db.Decimal(18, 2)
  itemDiscountTotal  Decimal            @default(0) @map("item_discount_total") @db.Decimal(18, 2)
  statusPayment      SalesPaymentStatus @map("status_payment")
  paidAmount         Decimal            @map("paid_amount") @db.Decimal(18, 2)
  outstandingAmount  Decimal            @map("outstanding_amount") @db.Decimal(18, 2)
  returnCreditAppliedAmount Decimal      @default(0) @map("return_credit_applied_amount") @db.Decimal(18, 2)
  status             SalesInvoiceStatus
  note               String?            @db.VarChar(500)
  createdAt          DateTime           @default(now()) @map("created_at")
  createdBy          BigInt             @map("created_by")
  updatedAt          DateTime?          @updatedAt @map("updated_at")
  updatedBy          BigInt?            @map("updated_by")
  approvedAt         DateTime?          @map("approved_at")
  approvedBy         BigInt?            @map("approved_by")
  cancelledAt        DateTime?          @map("cancelled_at")
  cancelledBy        BigInt?            @map("cancelled_by")

  salesOrder     SalesOrder? @relation(fields: [salesOrderId], references: [salesOrderId])
  customer       Customer?   @relation(fields: [customerId], references: [customerId])
  createdByUser  User        @relation("SalesInvoiceCreatedBy", fields: [createdBy], references: [userId])
  updatedByUser  User?       @relation("SalesInvoiceUpdatedBy", fields: [updatedBy], references: [userId])
  approvedByUser User?       @relation("SalesInvoiceApprovedBy", fields: [approvedBy], references: [userId])
  cancelledByUser User?      @relation("SalesInvoiceCancelledBy", fields: [cancelledBy], references: [userId])

  details  SalesInvoiceDetail[]
  payments SalesInvoicePayment[]
  paymentHoldings SalesPaymentHolding[]
  returns  SalesReturn[] @relation("SalesReturnSourceInvoice")
  replacementForReturn SalesReturn? @relation("SalesReturnReplacementInvoice")

  @@index([salesOrderId])
  @@index([customerId])
  @@index([createdBy])
  @@index([approvedBy])
  @@index([updatedBy])
  @@index([cancelledBy])
  @@index([status, invoiceDate])
  @@map("sales_invoice")
}

model SalesInvoiceDetail {
  salesInvoiceDetailId BigInt   @id @default(autoincrement()) @map("sales_invoice_detail_id")
  salesInvoiceId       BigInt   @map("sales_invoice_id")
  salesOrderDetailId   BigInt?  @map("sales_order_detail_id")
  productUnitId        BigInt   @map("product_unit_id")
  quantity             Decimal  @db.Decimal(18, 3)
  unitPrice            Decimal  @map("unit_price") @db.Decimal(18, 2)
  discountAmount       Decimal  @map("discount_amount") @db.Decimal(18, 2)
  bonusQuantity        Decimal  @default(0) @map("bonus_quantity") @db.Decimal(18, 3)
  subtotal             Decimal  @db.Decimal(18, 2)
  note                 String?  @db.VarChar(255)
  createdAt            DateTime @default(now()) @map("created_at")
  createdBy            BigInt   @map("created_by")

  salesInvoice     SalesInvoice      @relation(fields: [salesInvoiceId], references: [salesInvoiceId])
  salesOrderDetail SalesOrderDetail? @relation(fields: [salesOrderDetailId], references: [salesOrderDetailId])
  productUnit      ProductUnit       @relation(fields: [productUnitId], references: [productUnitId])
  createdByUser    User              @relation("SalesInvoiceDetailCreatedBy", fields: [createdBy], references: [userId])

  salesReturnDetails SalesReturnDetail[]
  inventoryMovement InventoryMovement?

  @@index([salesInvoiceId])
  @@index([salesOrderDetailId])
  @@index([productUnitId])
  @@index([createdBy])
  @@map("sales_invoice_detail")
}

model SalesInvoicePayment {
  salesPaymentId     BigInt             @id @default(autoincrement()) @map("sales_payment_id")
  paymentNumber      String             @unique @map("payment_number") @db.VarChar(30)
  salesInvoiceId     BigInt             @map("sales_invoice_id")
  paymentDate        DateTime           @map("payment_date")
  paymentMethod      String             @map("payment_method") @db.VarChar(50)
  financialAccountId BigInt             @map("financial_account_id")
  financialAccountTransactionId BigInt? @unique @map("financial_account_transaction_id")
  paymentAmount      Decimal            @map("payment_amount") @db.Decimal(18, 2)
  referenceNumber    String?            @map("reference_number") @db.VarChar(100)
  note               String?            @db.VarChar(255)
  createdAt          DateTime           @default(now()) @map("created_at")
  createdBy          BigInt             @map("created_by")

  salesInvoice     SalesInvoice     @relation(fields: [salesInvoiceId], references: [salesInvoiceId])
  financialAccount FinancialAccount @relation(fields: [financialAccountId], references: [financialAccountId])
  createdByUser    User             @relation("SalesInvoicePaymentCreatedBy", fields: [createdBy], references: [userId])
  financialAccountTransaction FinancialAccountTransaction? @relation(fields: [financialAccountTransactionId], references: [financialAccountTransactionId], onDelete: Restrict)
  holding SalesPaymentHolding?

  @@index([salesInvoiceId])
  @@index([financialAccountId])
  @@index([createdBy])
  @@map("sales_invoice_payment")
}

model SalesPaymentHolding {
  salesPaymentHoldingId BigInt @id @default(autoincrement()) @map("sales_payment_holding_id")
  salesInvoiceId        BigInt @map("sales_invoice_id")
  salesPaymentId        BigInt @unique @map("sales_payment_id")
  amount                Decimal @db.Decimal(18, 2)
  remainingAmount       Decimal @map("remaining_amount") @db.Decimal(18, 2)
  status                SalesPaymentHoldingStatus @default(HELD)
  resolvedAt            DateTime? @map("resolved_at")
  resolvedBy            BigInt? @map("resolved_by")
  createdAt             DateTime @default(now()) @map("created_at")

  salesInvoice SalesInvoice @relation(fields: [salesInvoiceId], references: [salesInvoiceId], onDelete: Restrict)
  payment      SalesInvoicePayment @relation(fields: [salesPaymentId], references: [salesPaymentId], onDelete: Restrict)
  resolvedByUser User? @relation("SalesPaymentHoldingResolvedBy", fields: [resolvedBy], references: [userId])

  @@index([salesInvoiceId, status])
  @@index([resolvedBy])
  @@map("sales_payment_holding")
}

model SalesReturn {
  salesReturnId     BigInt            @id @default(autoincrement()) @map("sales_return_id")
  salesReturnNumber String            @unique @map("sales_return_number") @db.VarChar(30)
  salesInvoiceId    BigInt            @map("sales_invoice_id")
  customerId        BigInt?           @map("customer_id")
  replacementSalesInvoiceId BigInt?   @unique @map("replacement_sales_invoice_id")
  resolutionType    SalesReturnResolutionType @default(REFUND) @map("resolution_type")
  receivableOffsetAmount Decimal      @default(0) @map("receivable_offset_amount") @db.Decimal(18, 2)
  replacementCreditAmount Decimal     @default(0) @map("replacement_credit_amount") @db.Decimal(18, 2)
  refundAmount      Decimal           @default(0) @map("refund_amount") @db.Decimal(18, 2)
  financialAccountId BigInt?          @map("financial_account_id")
  financialAccountTransactionId BigInt? @unique @map("financial_account_transaction_id")
  refundPaymentMethod String?         @map("refund_payment_method") @db.VarChar(50)
  returnDate        DateTime          @map("return_date")
  returnTotal       Decimal           @map("return_total") @db.Decimal(18, 2)
  status            SalesReturnStatus
  note              String?           @db.VarChar(500)
  createdAt         DateTime          @default(now()) @map("created_at")
  createdBy         BigInt            @map("created_by")
  approvedAt        DateTime?         @map("approved_at")
  approvedBy        BigInt?           @map("approved_by")

  salesInvoice   SalesInvoice @relation("SalesReturnSourceInvoice", fields: [salesInvoiceId], references: [salesInvoiceId])
  replacementSalesInvoice SalesInvoice? @relation("SalesReturnReplacementInvoice", fields: [replacementSalesInvoiceId], references: [salesInvoiceId])
  customer       Customer?    @relation(fields: [customerId], references: [customerId])
  financialAccount FinancialAccount? @relation("SalesReturnRefundAccount", fields: [financialAccountId], references: [financialAccountId])
  financialAccountTransaction FinancialAccountTransaction? @relation("SalesReturnRefundTransaction", fields: [financialAccountTransactionId], references: [financialAccountTransactionId])
  createdByUser  User         @relation("SalesReturnCreatedBy", fields: [createdBy], references: [userId])
  approvedByUser User?        @relation("SalesReturnApprovedBy", fields: [approvedBy], references: [userId])

  details SalesReturnDetail[]

  @@index([salesInvoiceId])
  @@index([customerId])
  @@index([status, returnDate])
  @@index([financialAccountId])
  @@index([createdBy])
  @@index([approvedBy])
  @@map("sales_return")
}

model SalesReturnDetail {
  salesReturnDetailId  BigInt   @id @default(autoincrement()) @map("sales_return_detail_id")
  salesReturnId        BigInt   @map("sales_return_id")
  salesInvoiceDetailId BigInt   @map("sales_invoice_detail_id")
  productUnitId        BigInt   @map("product_unit_id")
  quantity             Decimal  @db.Decimal(18, 3)
  bonusQuantity        Decimal  @default(0) @map("bonus_quantity") @db.Decimal(18, 3)
  unitPrice            Decimal  @map("unit_price") @db.Decimal(18, 2)
  subtotal             Decimal  @db.Decimal(18, 2)
  returnCostTotal      Decimal  @default(0) @map("return_cost_total") @db.Decimal(18, 2)
  reason               String?  @db.VarChar(100)
  note                 String?  @db.VarChar(255)
  createdAt            DateTime @default(now()) @map("created_at")
  createdBy            BigInt   @map("created_by")

  salesReturn        SalesReturn        @relation(fields: [salesReturnId], references: [salesReturnId])
  salesInvoiceDetail SalesInvoiceDetail @relation(fields: [salesInvoiceDetailId], references: [salesInvoiceDetailId])
  productUnit        ProductUnit        @relation(fields: [productUnitId], references: [productUnitId])
  createdByUser      User               @relation("SalesReturnDetailCreatedBy", fields: [createdBy], references: [userId])
  inventoryMovement InventoryMovement?

  @@index([salesReturnId])
  @@index([salesInvoiceDetailId])
  @@index([productUnitId])
  @@index([createdBy])
  @@map("sales_return_detail")
}

/**
 * PRICING
 */

model GuestSuggestedPrice {
  guestPriceId   BigInt    @id @default(autoincrement()) @map("guest_price_id")
  productUnitId  BigInt    @map("product_unit_id")
  suggestedPrice Decimal   @map("suggested_price") @db.Decimal(18, 2)
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      BigInt    @map("created_by")
  updatedAt      DateTime? @updatedAt @map("updated_at")
  updatedBy      BigInt?   @map("updated_by")

  productUnit   ProductUnit @relation(fields: [productUnitId], references: [productUnitId])
  createdByUser User        @relation("GuestPriceCreatedBy", fields: [createdBy], references: [userId])
  updatedByUser User?       @relation("GuestPriceUpdatedBy", fields: [updatedBy], references: [userId])

  @@index([productUnitId])
  @@index([createdBy])
  @@index([updatedBy])
  @@map("guest_suggested_price")
}

model CustomerSuggestedPrice {
  customerPriceId BigInt    @id @default(autoincrement()) @map("customer_price_id")
  customerId      BigInt    @map("customer_id")
  productUnitId   BigInt    @map("product_unit_id")
  suggestedPrice  Decimal   @map("suggested_price") @db.Decimal(18, 2)
  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       BigInt    @map("created_by")
  updatedAt       DateTime? @updatedAt @map("updated_at")
  updatedBy       BigInt?   @map("updated_by")

  customer      Customer    @relation(fields: [customerId], references: [customerId])
  productUnit   ProductUnit @relation(fields: [productUnitId], references: [productUnitId])
  createdByUser User        @relation("CustomerPriceCreatedBy", fields: [createdBy], references: [userId])
  updatedByUser User?       @relation("CustomerPriceUpdatedBy", fields: [updatedBy], references: [userId])

  @@unique([customerId, productUnitId])
  @@index([createdBy])
  @@index([updatedBy])
  @@map("customer_suggested_price")
}

model SupplierSuggestedCost {
  supplierCostId BigInt    @id @default(autoincrement()) @map("supplier_cost_id")
  supplierId     BigInt    @map("supplier_id")
  productUnitId  BigInt    @map("product_unit_id")
  suggestedCost  Decimal   @map("suggested_cost") @db.Decimal(18, 2)
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      BigInt    @map("created_by")
  updatedAt      DateTime? @updatedAt @map("updated_at")
  updatedBy      BigInt?   @map("updated_by")

  supplier      Supplier    @relation(fields: [supplierId], references: [supplierId])
  productUnit   ProductUnit @relation(fields: [productUnitId], references: [productUnitId])
  createdByUser User        @relation("SupplierCostCreatedBy", fields: [createdBy], references: [userId])
  updatedByUser User?       @relation("SupplierCostUpdatedBy", fields: [updatedBy], references: [userId])

  @@unique([supplierId, productUnitId])
  @@index([createdBy])
  @@index([updatedBy])
  @@map("supplier_suggested_cost")
}

model ProductAlias {
  productAliasId BigInt   @id @default(autoincrement()) @map("product_alias_id")
  productId      BigInt   @map("product_id")
  aliasName      String   @unique @map("alias_name") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at")
  createdBy      BigInt   @map("created_by")

  product       Product @relation(fields: [productId], references: [productId])
  createdByUser User    @relation("ProductAliasCreatedBy", fields: [createdBy], references: [userId])

  @@index([productId])
  @@index([createdBy])
  @@map("product_alias")
}

model UnitAlias {
  unitAliasId BigInt   @id @default(autoincrement()) @map("unit_alias_id")
  unitId      BigInt   @map("unit_id")
  aliasName   String   @unique @map("alias_name") @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   BigInt   @map("created_by")

  unit          Unit @relation(fields: [unitId], references: [unitId])
  createdByUser User @relation("UnitAliasCreatedBy", fields: [createdBy], references: [userId])

  @@index([unitId])
  @@index([createdBy])
  @@map("unit_alias")
}

/**
 * LOGGING
 */

model AuditLog {
  auditLogId    BigInt   @id @default(autoincrement()) @map("audit_log_id")
  userId        BigInt   @map("user_id")
  action        String   @db.VarChar(50)
  entityType    String   @map("entity_type") @db.VarChar(50)
  entityId      BigInt   @map("entity_id")
  entityNumber  String?  @map("entity_number") @db.VarChar(50)
  transactionId String?  @map("transaction_id") @db.VarChar(50)
  module        String?  @db.VarChar(50)
  source        String?  @db.VarChar(150)
  changedFields Json?    @map("changed_fields")
  reason        String?  @db.VarChar(255)
  ipAddress     String?  @map("ip_address") @db.VarChar(45)
  userAgent     String?  @map("user_agent") @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [userId])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([transactionId])
  @@index([module, createdAt])
  @@map("audit_log")
}

model ActivityLog {
  activityLogId BigInt   @id @default(autoincrement()) @map("activity_log_id")
  userId        BigInt   @map("user_id")
  activityType  String   @map("activity_type") @db.VarChar(50)
  entityType    String?  @map("entity_type") @db.VarChar(50)
  entityId      BigInt?  @map("entity_id")
  entityNumber  String?  @map("entity_number") @db.VarChar(50)
  module        String?  @db.VarChar(50)
  description   String   @db.VarChar(500)
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [userId])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([module, activityType, createdAt])
  @@map("activity_log")
}

model SecurityLog {
  securityLogId BigInt   @id @default(autoincrement()) @map("security_log_id")
  userId        BigInt?  @map("user_id")
  eventType     String   @map("event_type") @db.VarChar(50)
  ipAddress     String?  @map("ip_address") @db.VarChar(45)
  userAgent     String?  @map("user_agent") @db.VarChar(500)
  success       Boolean
  failureReason String?  @map("failure_reason") @db.VarChar(255)
  description   String?  @db.VarChar(500)
  reference     String?  @db.VarChar(100)
  createdAt     DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [userId])

  @@index([userId])
  @@index([eventType, createdAt])
  @@index([ipAddress, createdAt])
  @@map("security_log")
}

