  @@index([createdBy])
  @@map("inventory_transformation")
}

model InventoryTransformationDetail {
  transformationDetailId BigInt   @id @default(autoincrement()) @map("transformation_detail_id")
  transformationId       BigInt   @map("transformation_id")
  lineNumber             Int      @map("line_number")
  sourceProductUnitId    BigInt   @map("source_product_unit_id")
  sourceQuantity         Decimal  @map("source_quantity") @db.Decimal(18, 3)
  resultProductUnitId    BigInt   @map("result_product_unit_id")
  resultQuantity         Decimal  @map("result_quantity") @db.Decimal(18, 3)
  sourceCostTotal        Decimal  @map("source_cost_total") @db.Decimal(18, 2)
  suggestedUnitCost      Decimal  @map("suggested_unit_cost") @db.Decimal(18, 2)
  appliedUnitCost        Decimal  @map("applied_unit_cost") @db.Decimal(18, 2)
  resultCostTotal        Decimal  @map("result_cost_total") @db.Decimal(18, 2)
  valuationVariance      Decimal  @map("valuation_variance") @db.Decimal(18, 2)
  note                   String?  @db.VarChar(255)
  createdAt              DateTime @default(now()) @map("created_at")
  createdBy              BigInt   @map("created_by")

  transformation    InventoryTransformation                 @relation(fields: [transformationId], references: [transformationId], onDelete: Restrict)
  sourceProductUnit ProductUnit                             @relation("TransformationSourceUnit", fields: [sourceProductUnitId], references: [productUnitId])
  resultProductUnit ProductUnit                             @relation("TransformationResultUnit", fields: [resultProductUnitId], references: [productUnitId])
  createdByUser     User                                    @relation("InventoryTransformationDetailCreatedBy", fields: [createdBy], references: [userId])
  movementLinks     InventoryTransformationMovementDetail[]

  @@unique([transformationId, lineNumber])
  @@index([sourceProductUnitId])
  @@index([resultProductUnitId])
  @@index([createdBy])
  @@map("inventory_transformation_detail")
}

model InventoryTransformationMovementDetail {
  transformationMovementDetailId BigInt                     @id @default(autoincrement()) @map("transformation_movement_detail_id")
  transformationDetailId         BigInt                     @map("transformation_detail_id")
  inventoryMovementId            BigInt                     @map("inventory_movement_id")
  movementRole                   TransformationMovementRole @map("movement_role")
  allocatedQuantity              Decimal                    @map("allocated_quantity") @db.Decimal(18, 3)
  allocatedCost                  Decimal                    @map("allocated_cost") @db.Decimal(18, 2)
  createdAt                      DateTime                   @default(now()) @map("created_at")

  transformationDetail InventoryTransformationDetail @relation(fields: [transformationDetailId], references: [transformationDetailId], onDelete: Restrict)
  inventoryMovement    InventoryMovement             @relation(fields: [inventoryMovementId], references: [inventoryMovementId], onDelete: Restrict)

  @@unique([transformationDetailId, inventoryMovementId, movementRole], map: "inventory_transformation_movement_detail_unique")
  @@index([inventoryMovementId, movementRole], map: "inventory_transformation_movement_detail_movement_role_idx")
  @@index([transformationDetailId], map: "inventory_transformation_movement_detail_detail_idx")
  @@map("inventory_transformation_movement_detail")
}

model InventoryMovement {
  inventoryMovementId BigInt               @id @default(autoincrement()) @map("inventory_movement_id")
  movementNumber      String               @unique @map("movement_number") @db.VarChar(30)
  productUnitId       BigInt               @map("product_unit_id")
  direction           TransactionDirection @map("direction")
  quantity            Decimal              @db.Decimal(18, 3)
  movementType        String               @map("movement_type") @db.VarChar(50)
  originType          String               @map("origin_type") @db.VarChar(50)
  originId            BigInt               @map("origin_id")
  originNumber        String               @map("origin_number") @db.VarChar(30)
  transformationId    BigInt?              @map("transformation_id")
  salesInvoiceDetailId BigInt?             @unique @map("sales_invoice_detail_id")
  salesReturnDetailId  BigInt?             @unique @map("sales_return_detail_id")
  movementDate        DateTime             @map("movement_date")
  note                String?              @db.VarChar(255)
  createdAt           DateTime             @default(now()) @map("created_at")
  createdBy           BigInt               @map("created_by")

  productUnit    ProductUnit              @relation(fields: [productUnitId], references: [productUnitId])
  transformation InventoryTransformation? @relation(fields: [transformationId], references: [transformationId])
  salesInvoiceDetail SalesInvoiceDetail?  @relation(fields: [salesInvoiceDetailId], references: [salesInvoiceDetailId], onDelete: Restrict)
  salesReturnDetail  SalesReturnDetail?   @relation(fields: [salesReturnDetailId], references: [salesReturnDetailId], onDelete: Restrict)
  createdByUser  User                     @relation("InventoryMovementCreatedBy", fields: [createdBy], references: [userId])

  generatedLayers           FifoLayer[]                             @relation("MovementGeneratedLayers")
  consumedLayers            FifoLayerTransaction[]                  @relation("MovementConsumedLayers")
  transformationDetailLinks InventoryTransformationMovementDetail[]

  @@index([productUnitId])
  @@index([originType, originId])
  @@index([originType, originNumber])
  @@index([movementDate, inventoryMovementId], map: "inventory_movement_date_id_idx")
  @@index([transformationId])
  @@index([salesInvoiceDetailId])
  @@index([salesReturnDetailId])
  @@index([createdBy])
  @@map("inventory_movement")
}

